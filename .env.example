# Copy this file to `.env` and fill in the real secrets before running Docker.
# Docker Compose loads `.env` via `env_file`.

# Telegram application credentials (optional if you rely on the shared defaults)
ESTRATTO_TELEGRAM_API_ID=
ESTRATTO_TELEGRAM_API_HASH=

# OpenAI classification
ESTRATTO_OPENAI_API_KEY=

# Email auth / SMTP
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=login@example.com
MAIL_PASS=
MAIL_FROM=Estratto <login@example.com>
EMAIL_CODE_TTL_MINUTES=15
